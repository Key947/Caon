#include <dt-bindings/zmk/matrix_transform.h>

// Matrix Kscan And OLED

/ { 
    chosen {
        zephyr,display = &oled;
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios =
            <&shift_reg 7 (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 6 (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 15 (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 14 (GPIO_ACTIVE_HIGH)>
        ;

        row-gpios =
            <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
    };

// Top Encoders

    top_encoder: encoder_top {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

// Bottom Encoders

    bottom_encoder: encoder_bottom {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

// Encoders as Sensors

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&top_encoder &bottom_encoder>;
        triggers-per-rotation = <36>;
    };

// Matrix Kscan Transform

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        
        rows = <2>;
        columns = <4>;

        map =
            <   
                RC(0,0) RC(0,1) RC(0,2) RC(0,3)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            >
        ;
    };
};

// SPI Pin Control

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels =
                <NRF_PSEL (SPIM_SCK, 0, 8)>,
                <NRF_PSEL (SPIM_MOSI, 0, 6)>,
                <NRF_PSEL (SPIM_MISO, 1, 7)>            // Unused MISO
            ;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels =     
                <NRF_PSEL (SPIM_SCK, 0, 8)>,
                <NRF_PSEL (SPIM_MOSI, 0, 6)>,
                <NRF_PSEL (SPIM_MISO, 1, 7)>            // Unused MISO
            ;
            low-power-enable
            ;
        };
    };
};

// I2C Pin Control

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = 
                <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 22)>
            ;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = 
                <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 22)>
            ;
            low-power-enable
            ;
        };
    };
};

// Shift Register SPI Device Definition

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;                                                // Default pin configuration
    pinctrl-1 = <&spi1_sleep>;                                                  // Low power pin configuration
    pinctrl-names = "default", "sleep";                                         // Names of the pin configurations 
    
        cs-gpios =
            <&gpio0 17 GPIO_ACTIVE_LOW>                                         // Pin 0.17 for CS (Chip Select), active low
        ;
        
    shift_reg: 595@0 {
        compatible = "zmk,gpio-595";                                            // Specification of the compatible device
        status = "okay";                                                        // okay
        gpio-controller;
        spi-max-frequency = <400000>;                                           // Maximum SPI frequency (4 MHz) 
        #gpio-cells = <2>;
        reg = <0>;                                                              // SPI device address
        ngpios = <16>;                                                          // 8 per shift register chained
    };
};

// OLED Device Definition

&pro_micro_i2c {
    compatible = "nordic,nrf-twim"; // I2C controller instead of generic
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

// Encoder Enables

&top_encoder {
    status = "okay";
};

&bottom_encoder {
    status = "okay";
};
