#include <dt-bindings/zmk/matrix_transform.h>

// Matrix Kscan And OLED

/ { 
    chosen {
        zephyr,display = &oled;
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        
        col-gpios =
            <&shift_reg 7   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 6   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 5   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 4   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 3   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 2   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 1   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 0   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 14  (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 13  (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 12  (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 11  (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 10  (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 9   (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 8   (GPIO_ACTIVE_HIGH)>
        ;

        row-gpios =
            <&gpio0 31  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 29  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 2   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 15  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 13  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
    };

// Top Encoders

    top_encoder: encoder_top {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <18>;
        status = "disabled";
    };

// Bottom Encoders

    bottom_encoder: encoder_bottom {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <18>;
        status = "disabled";
    };

// Encoders as Sensors

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&top_encoder &bottom_encoder>;
        triggers-per-rotation = <9>;
    };

// Matrix Kscan Transform

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        
                // ESC       1       2       3       4       5       6       7       8       9       0       -       =        BACK       BACK
                // TAB       Q       W       E       R       T       Y       U       I       O       P       [       ]        \          ENC_SW0
                // CAPS      A       S       D       F       G       H       J       K       L       ;       '       ENTER    ENTER      ENC_SW1
                // SHIFT     SHIFT   Z       X       C       V       B       N       M       ,       .       /       SHIFT    ↑          (Unused)      
                // CTRL      WIN     FN      ALT     SPC     SPC     SPC     SPC     SPC     FN      `       DEL     ←        ↓          →
  
        rows = <5>;
        columns = <15>;
        map =
            <   
                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
                RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
                RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14)   /* RC(3,14) are unused for the time being */      
                RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14)
            >
        ;
    };
};

// SPI Pin Control

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels =
                <NRF_PSEL (SPIM_SCK, 0, 8)>,
                <NRF_PSEL (SPIM_MOSI, 0, 6)>,
                <NRF_PSEL (SPIM_MISO, 1, 7)>            // Unused MISO
            ;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels =     
                <NRF_PSEL (SPIM_SCK, 0, 8)>,
                <NRF_PSEL (SPIM_MOSI, 0, 6)>,
                <NRF_PSEL (SPIM_MISO, 1, 7)>            // Unused MISO
            ;
            low-power-enable
            ;
        };
    };

// I2C Pin Control

    i2c0_default: i2c0_default {
        group1 {    
            psels = 
                <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 22)>
            ;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = 
                <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 22)>
            ;
            low-power-enable
            ;
        };
    };
};

// Shift Register SPI Device Definition

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    
        cs-gpios =
            <&gpio0 17 GPIO_ACTIVE_LOW>                                         // Pin 0.17 for CS (Chip Select), active low
        ;
        
    shift_reg: 595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";                                                        // okay
        gpio-controller;
        spi-max-frequency = <400000>;                                           // Maximum SPI frequency (4 MHz) 
        #gpio-cells = <2>;
        reg = <0>;
        ngpios = <16>;                                                          // 8 per shift register chained
    };
};

// OLED Device Definition

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

// Encoder Enables

&top_encoder {
    status = "okay";
};

&bottom_encoder {
    status = "okay";
};