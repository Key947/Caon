#include <dt-bindings/zmk/matrix_transform.h>

// Matrix Kscan

/ { 
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios =
            <&shift_reg 7 (GPIO_ACTIVE_HIGH)>,
            <&shift_reg 6 (GPIO_ACTIVE_HIGH)>
        ;

        row-gpios =
            <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
    };

// Matrix Kscan Transform

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        
        rows = <2>;
        columns = <2>;

        map =
            <   
                RC(0,0) RC(0,1)
                RC(1,0) RC(1,1)
            >
        ;
    };
};

// Encoders GPIO Assignment

    test_encoder: encoder_test {
        compatible = "alps,ec11";

        a-gpios =
            <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>
        ;

        b-gpios =
            <&gpio0 09 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>
        ;

        steps = <80>;
        status = "disabled";
    };
 
        sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&test_encoder>;
        triggers-per-rotation = <20>;
    };

&test_encoder {
    status = "okay";
};

// SPI Pin Control

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels =
                <NRF_PSEL (SPIM_SCK, 0, 8)>,
                <NRF_PSEL (SPIM_MOSI, 0, 6)>,
                <NRF_PSEL (SPIM_MISO, 0, 20)>
            ;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels =     
                <NRF_PSEL (SPIM_SCK, 0, 8)>,
                <NRF_PSEL (SPIM_MOSI, 0, 6)>,
                <NRF_PSEL (SPIM_MISO, 0, 20)>
            ;
            low-power-enable
            ;
        };
    };
};

// Shift Register SPI Device Definition

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;                                                // Default pin configuration
    pinctrl-1 = <&spi1_sleep>;                                                  // Low power pin configuration
    pinctrl-names = "default", "sleep";                                         // Names of the pin configurations 
    
        cs-gpios =
            <&gpio0 17 GPIO_ACTIVE_LOW>                                         // Pin 0.17 for CS (Chip Select), active low
        ;
        
    shift_reg: 595@0 {
        compatible = "zmk,gpio-595";                                            // Specify the compatible device
        status = "okay";
        gpio-controller;
        spi-max-frequency = <200000>;                                           // Maximum SPI frequency (2 MHz)
        #gpio-cells = <2>;
        reg = <0>;                                                              // SPI device address
        ngpios = <8>;
    };
};