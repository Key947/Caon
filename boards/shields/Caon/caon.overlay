#include <dt-bindings/zmk/matrix_transform.h>

&pro_micro_spi {
    status = "okay";
    cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
    shifter: 595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        gpio-controller;
        spi-max-frequency = <200000>; // should be 400000 but 200000 for testing
        reg = <0>;
        #gpio-cells = <2>;
        ngpios = <8>; // should be 16 but 8 for testing
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        col-gpios
            = <&shifter 0 GPIO_ACTIVE_HIGH>                               // QA Pin, col0
            , <&shifter 1 GPIO_ACTIVE_HIGH>                               // QB Pin, col1
            , <&shifter 2 GPIO_ACTIVE_HIGH>                               // QC Pin, col2
            , <&shifter 3 GPIO_ACTIVE_HIGH>                               // QD Pin, col3
            , <&shifter 4 GPIO_ACTIVE_HIGH>                               // QE Pin, col4
            , <&shifter 5 GPIO_ACTIVE_HIGH>                               // QF Pin, col5
            , <&shifter 6 GPIO_ACTIVE_HIGH>                               // QG Pin, col6
            , <&shifter 7 GPIO_ACTIVE_HIGH>                               // QH Pin, col7
        ;

        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>             // Row0
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>             // Row1
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>             // Row2
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>             // Row3
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>             // Row4
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <8>;
        columns = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)     // col2row test
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)
        >;
    };
};