&pinctrl {                                            /* configuration for spi0 device, default state */
    spi0_default: spi0_default {                      /* node name is arbitrary */

        group1 {           
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,      /* main role: configure P0.20 as SPI clock, P0.17 as SPI MOSI, P0.22 as SPI MISO */
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 22)>;
        };
    };

    spi0_sleep: spi0_sleep {                          /* configuration for spi0 device, sleep state */
        group1 {           
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,      /* main role: configure P0.20 as SPI clock, P0.17 as SPI MOSI, P0.22 as SPI MISO */
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 22)>;
            low-power-enable;
        };
    };

};
