#define ZMK_POINTING_DEFAULT_MOVE_VAL 1600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define LOWER 1

// Sensor Rotate Behavior for Encoders

/ { 
    behaviors {
        mouse_scroll: sensor_scroll {
        	compatible = "zmk,behavior-sensor-rotate-var";
        	#sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <40>;
		};
    };

    behaviors {
        mouse_move: sensor_move {
        	compatible = "zmk,behavior-sensor-rotate-var";
        	#sensor-binding-cells = <2>;
            bindings = <&mmv>, <&mmv>;
            tap-ms = <40>;
		};
    };

// Keymap Default Layer Config

      keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <

                &kp A     &kp B     &kp C     &kp D
                &kp E     &kp F     &kp G     &mo LOWER

            >;
            sensor-bindings = <&mouse_move MOVE_UP MOVE_DOWN &mouse_move MOVE_LEFT MOVE_RIGHT>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <

                &kp N1     &kp N2     &kp N3     &kp N4
                &kp N5     &kp N6     &kp N7     &trans

            >;
            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN &mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };
    };
};