#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// | ESC   |   1   |  2   |   3   |  4   |   5    |  6   |   7   |
// | TAB   |   Q   |  W   |   E   |  R   |   T    |  Y   |   U   |
// | CAPS  |   A   |  S   |   D   |  F   |   G    |  H   |   J   |
// | SHIFT |   Z   |  X   |   C   |  V   |   B    |  N   |   M   |
// | RCTRL |  GUI  | RALT | SPACE | LALT | Layer1 | RET  | LCTRL |
// ---------------------------------------------------------------------------------------------------------------------------------
            bindings = <
    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8
    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I
    &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K
    &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp L
    &kp N9     &kp N0     &kp O      &kp P      &kp K      &kp L      &kp M      &kp N

            >;
        };

    };
};

