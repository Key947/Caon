#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// | ESC   |   1   |  2   |   3   |  4   |   5    |  6   |   7   |
// | TAB   |   Q   |  W   |   E   |  R   |   T    |  Y   |   U   |
// | CAPS  |   A   |  S   |   D   |  F   |   G    |  H   |   J   |
// | SHIFT |   Z   |  X   |   C   |  V   |   B    |  N   |   M   |
// | RCTRL |  GUI  | RALT | SPACE | LALT | Layer1 | RET  | LCTRL |
// ---------------------------------------------------------------------------------------------------------------------------------
            bindings = <
    &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7
    &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U
    &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J
    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M
    &kp RCTRL  &kp LGUI   &kp RALT   &kp SPACE  &kp LALT   &mo 1      &kp RET    &kp LCTRL
            >;
        };

        function_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// |       |      |BT_CLR|BTSEL0|BTSEL1|BTSEL2|       |      |
// |       |      |      |BTSEL3|BTSEL4|      |       |      |
// |       |      |      |      |      |      |       |      |
// |       |      |      |      |      |      |       |      |
// |       |      |      |      |      |      |       |      |
// ---------------------------------------------------------------------------------------------------------------------------------
            bindings = <
    &trans    &trans    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2   &trans &trans
    &trans    &trans    &trans     &bt BT_SEL 3 &bt BT_SEL 4 &trans         &trans &trans
    &trans    &trans    &trans     &trans       &trans       &trans         &trans &trans
    &trans    &trans    &trans     &trans       &trans       &trans         &trans &trans
    &trans    &trans    &trans     &trans       &trans       &trans         &trans &trans
            >;
        };
    };
};

