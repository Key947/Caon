#define ZMK_POINTING_DEFAULT_MOVE_VAL 6000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define TOP 1
#define LOWER 2
#define AUXILIARY 3

// Sensor Rotate Behavior for Encoders

/ { 
    behaviors {
        mouse_scroll: sensor_scroll {
        	compatible = "zmk,behavior-sensor-rotate-var";
        	#sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <40>;
		};
    };

    behaviors {
        mouse_move: sensor_move {
        	compatible = "zmk,behavior-sensor-rotate-var";
        	#sensor-binding-cells = <2>;
            bindings = <&mmv>, <&mmv>;
            tap-ms = <40>;
		};
    };

    behaviors {
        cursor_moving: cursor_move {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            trigger-period-ms = <10>;        
            time-to-max-speed-ms = <100>;
            acceleration-exponent = <2>;
        };
    };

// Keymap Default Layer Config

      keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
  
                // ESC           1               2                3             4               5               6           7           8           9           0           -           =            BACK           BACK
                // TAB           Q               W                E             R               T               Y           U           I           O           P           [           ]            \              ENC_SW0
                // CAPS          A               S                D             F               G               H           J           K           L           ;           '           ENTER        ENTER          ENC_SW1
                // LSHFT         LSHFT           Z                X             C               V               B           N           M           ,           .           /           SHIFT        ↑              (Unused) 
                // LCTRL         WIN             FN               ALT           SPC             SPC             SPC         SPC         SPC         FN          `           DEL         ←            ↓              →
    
                &kp ESC          &kp N1          &kp N2           &kp N3        &kp N4          &kp N5          &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS   &kp EQUAL    &kp BSPC       &kp BSPC 
                &kp TAB          &kp Q           &kp W            &kp E         &kp R           &kp T           &kp Y       &kp U       &kp I       &kp O       &kp P       &kp LBKT    &kp RBKT     &kp BSLH       &mkp MB1
                &kp CAPS         &kp A           &kp S            &kp D         &kp F           &kp G           &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT     &kp RET      &kp RET        &mkp MB2
                &kp LSHIFT       &kp LSHIFT      &kp Z            &kp X         &kp C           &kp V           &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT    &kp UP         &none
                &kp LCTRL        &kp LGUI        &mo 3            &kp LALT      &kp SPACE       &mo 1           &mo 2       &mo 3       &kp SPACE   &mo 1       &kp GRAVE   &kp DEL     &kp LEFT     &kp DOWN       &kp RIGHT 

            >;
            sensor-bindings = <&mouse_move MOVE_UP MOVE_DOWN &mouse_move MOVE_LEFT MOVE_RIGHT>;
            
        };

        top_layer {
            display-name = "Top";
            bindings = <

                // ESC           1               2               3              4               5               6           7           8           9           0           -           =            BACK           BACK
                // TAB           Q               W               E              R               T               Y           U           I           O           P           [           ]            \              ENC_SW0
                // CAPS          A               S               D              F               G               H           J           K           L           ;           '           ENTER        ENTER          ENC_SW1
                // LSHFT         LSHFT           Z               X              C               V               B           N           M           ,           .           /           SHIFT        ↑              (Unused) 
                // LCTRL         WIN             FN              ALT            SPC             SPC             SPC         SPC         SPC         FN          `           DEL         ←            ↓              →
        
                &bt BT_CLR       &kp PG_UP       &kp PG_DN       &kp INS        &none           &none           &none       &none       &none       &none       &none       &none       &none        &sys_reset     &bootloader
                &kp TAB          &kp DEL         &kp UP          &kp BSPC       &kp PSCRN       &kp HOME        &kp Y       &kp U       &kp I       &kp O       &kp P       &none       &none        &none          &mkp MB3
                &kp CAPS         &kp LEFT        &kp DOWN        &kp RIGHT      &kp RET         &kp END         &kp H       &kp J       &kp K       &kp L       &none       &none       &none        &none          &none
                &kp LSHIFT       &kp LSHIFT      &kp C_VOL_DN    &kp C_VOL_UP   &kp C_MUTE      &none           &kp B       &kp N       &kp M       &none       &none       &none       &none        &none          &none
                &kp LCTRL        &kp LGUI        &none           &none          &none           &mkp MB1        &none       &none       &none       &none       &none       &kp LCTRL   &none        &none          &none

            >;
            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN &mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };

        lower_layer {
            display-name = "Low";
            bindings = <
  
                // ESC           1               2                3             4               5               6           7           8           9           0           -           =            BACK           BACK
                // TAB           Q               W                E             R               T               Y           U           I           O           P           [           ]            \              ENC_SW0
                // CAPS          A               S                D             F               G               H           J           K           L           ;           '           ENTER        ENTER          ENC_SW1
                // LSHFT         LSHFT           Z                X             C               V               B           N           M           ,           .           /           SHIFT        ↑              (Unused) 
                // LCTRL         WIN             FN               ALT           SPC             SPC             SPC         SPC         SPC         FN          `           DEL         ←            ↓              →
    
                &kp ESC          &kp F1          &kp F2           &kp F3        &kp F4          &kp F5          &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11     &kp F12      &none          &none
                &kp TAB          &kp N1          &kp N2           &kp N3        &kp N0          &none           &none       &none       &none       &none       &none       &none       &none        &none          &mkp MB4
                &kp CAPS         &kp N4          &kp N5           &kp N6        &kp N0          &none           &none       &none       &none       &none       &none       &none       &none        &none          &mkp MB5
                &kp LSHIFT       &kp LSHIFT      &kp N7           &kp N8        &kp N9          &none           &none       &none       &none       &none       &none       &none       &none        &none          &none
                &kp LCTRL        &kp LGUI        &none            &kp LALT      &kp SPACE       &none           &none       &none       &none       &none       &none       &none       &none        &none          &none

            >;
            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN &mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };

        auxiliary_layer {
            display-name = "Aux";
            bindings = <
  
                // ESC           1               2                3                 4               5               6           7           8           9           0           -           =            BACK           BACK
                // TAB           Q               W                E                 R               T               Y           U           I           O           P           [           ]            \              ENC_SW0
                // CAPS          A               S                D                 F               G               H           J           K           L           ;           '           ENTER        ENTER          ENC_SW1
                // LSHFT         LSHFT           Z                X                 C               V               B           N           M           ,           .           /           SHIFT        ↑              (Unused) 
                // LCTRL         WIN             FN               ALT               SPC             SPC             SPC         SPC         SPC         FN          `           DEL         ←            ↓              →
    
                &bt BT_CLR       &bt BT_SEL 0    &bt BT_SEL 1     &bt BT_SEL 2      &bt BT_SEL 3    &bt BT_SEL 4    &none       &none       &none       &none       &none       &none       &none        &none          &none
                &kp TAB          &mkp MB4        &mmv MOVE_UP     &mkp MB5          &none           &none           &none       &none       &none       &none       &none       &none       &none        &none          &mkp MB4
                &kp CAPS         &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT   &mkp MB1        &mkp MB2        &none       &none       &none       &none       &none       &none       &none        &none          &mkp MB5
                &kp LSHIFT       &bt BT_PRV      &bt BT_NXT       &none             &none           &none           &none       &none       &none       &none       &none       &none       &none        &none          &none
                &kp LCTRL        &kp LGUI        &none            &none             &none           &none           &none       &none       &none       &none       &none       &none       &none        &none          &none

            >;
            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN &mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };
    };
};

